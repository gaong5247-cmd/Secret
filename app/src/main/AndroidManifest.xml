<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar"
    android:allowBackup="false" android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:screenOrientation="landscape" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <activity android:name=".AlphaTerrActivity" android:screenOrientation="landscape" android:exported="false"/>
    <service android:name=".AlphaTerrCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection"/>
    <service android:name=".AlphaTerrTouchService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/alphaterr_accessibility"/>
    </service>
    <service android:name=".CaptureService" android:exported="false" android:foregroundServiceType="mediaProjection"/>
    <service android:name=".TouchService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config"/>
    </service>
  </application>
</manifest>
